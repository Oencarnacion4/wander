# Recommended: fast, reliable place search (free, see SETUP.md). Without it, WANDER uses slower free servers.
GEOAPIFY_API_KEY=

# Optional: turn on accounts + cloud sync (see SETUP.md). Without these, WANDER runs in guest mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: identifies your app to OpenStreetMap services (recommended when deployed).
CONTACT_EMAIL=
