# Recommended: fast, reliable place search (free, see SETUP.md). Without it, WANDER uses slower free servers.
GEOAPIFY_API_KEY=

# Optional: "Cheapest flights" in Take Me Somewhere (free Travelpayouts/Aviasales data token, see SETUP.md).
TRAVELPAYOUTS_TOKEN=

# Optional: turn on accounts + cloud sync (see SETUP.md). Without these, WANDER runs in guest mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (older Supabase projects call it NEXT_PUBLIC_SUPABASE_ANON_KEY; either name works)
# Optional: identifies your app to OpenStreetMap services (recommended when deployed).
CONTACT_EMAIL=
